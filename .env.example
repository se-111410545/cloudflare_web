# ============================================================
#  本機環境變數（複製成 .env 後修改）
#
#    cp .env.example .env
#
#  .env 已被 .gitignore 排除，不會提交到版本庫。
#  請勿將實際密碼 / PIN 提交到 GitHub。
# ============================================================

# ------------------------------------------------------------
# JWT 簽章密鑰（本機用；正式環境請用 npx wrangler secret put JWT_SECRET）
# ------------------------------------------------------------
JWT_SECRET="dev-secret-change-me-in-production"

# ------------------------------------------------------------
# 最高管理者 (Boss) 的 PIN —— 必填，4-6 位數
#
# 這組 PIN 會在執行 `npm run db:seed` 時以 bcrypt 雜湊寫入資料庫，
# 資料庫中不會保留明文。
#
# ⚠️ 請勿使用已出現在文件、對話紀錄或公開程式碼中的 PIN
# ------------------------------------------------------------
ADMIN_PIN="1234"

# ------------------------------------------------------------
# 最高管理者 (Boss) 的登入密碼 —— 必填
# 用於「帳密登入」，同樣以 bcrypt 雜湊儲存
# ------------------------------------------------------------
ADMIN_PASSWORD="change-this-admin-password"

# ------------------------------------------------------------
# 其他角色的 PIN —— 選填
#
# 未設定時，種子腳本會自動產生一組隨機 PIN 並於執行結果中顯示，
# 避免使用公開可預測的預設值（例如 0002 / 0003 / 0004）。
# ------------------------------------------------------------
# MANAGER_PIN="5678"
# SUPERVISOR_PIN="9012"
# STAFF_PIN="3456"

# ------------------------------------------------------------
# 是否允許「遠端」管理寫入
#
# false（預設，強烈建議）：線上部署時封鎖高風險寫入
#   - 新增 / 修改 / 刪除員工與權限
#   - 新增 / 修改 / 刪除商品與分類
#   - 上傳 / 刪除檔案
#   - 刪除訂單
#   同時將 Boss 權限降級為 Store Manager。
#   本機（localhost / 127.0.0.1）不受影響，管理功能完整可用。
#
# true：開放遠端管理寫入（僅在確定部署環境可信時使用）
#
# 正式環境請用：npx wrangler secret put ALLOW_REMOTE_ADMIN
# ------------------------------------------------------------
ALLOW_REMOTE_ADMIN="false"
