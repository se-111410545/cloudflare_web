{
  "name": "cloudflare_web",
  "version": "1.0.0",
  "private": true,
  "description": "POS & Online Ordering System on Cloudflare (Workers + D1 + R2 + Pages)",
  "scripts": {
    "dev": "wrangler dev src/index.ts",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create pos-db",
    "d1:migrate": "wrangler d1 execute pos-db --file=migrations/0001_initial.sql",
    "d1:migrate:local": "wrangler d1 execute pos-db --local --file=migrations/0001_initial.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.68.0"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "jose": "^5.2.0"
  }
}