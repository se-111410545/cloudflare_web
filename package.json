{
  "name": "cloudflare_web",
  "version": "1.2.0",
  "private": true,
  "description": "POS & Online Ordering System (Workers + D1 + Static Assets) — 本機檔案儲存版本",
  "scripts": {
    "dev": "tsx watch server/local.ts",
    "dev:worker": "node scripts/sync-dev-vars.mjs && wrangler dev --local --port 8787 --ip 127.0.0.1",
    "dev:web": "npm --prefix frontend run dev",
    "db:migrate": "node scripts/migrate.mjs --local",
    "db:migrate:remote": "node scripts/migrate.mjs --remote",
    "db:seed": "tsx scripts/seed.mjs",
    "db:seed:remote": "tsx scripts/seed.mjs --remote",
    "db:seed-images": "tsx scripts/seed-images.mjs",
    "db:seed-images:remote": "tsx scripts/seed-images.mjs --remote",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:reset": "node scripts/reset-db.mjs",
    "db:reset-admin": "tsx scripts/reset-admin.mjs",
    "db:query": "node scripts/query.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "build": "npm run typecheck && npm run build:frontend",
    "build:frontend": "npm --prefix frontend run build",
    "deploy": "npm run build && wrangler deploy",
    "env:sync": "node scripts/sync-dev-vars.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241106.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.4.0",
    "wrangler": "^3.68.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.4.0",
    "jose": "^5.2.0"
  }
}
